---
import { club } from '../data/club';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${club.name} (${club.short}) — ${club.motto}`,
  description = `${club.name} (${club.short}). ${club.motto}. ${club.campo}, ${club.zona}. Equipo Senior y escuela M8–M18.`,
} = Astro.props;

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={club.name} />
    <meta property="og:image" content="https://urc.xvdelcorzo.com/escudo.jpg" />
    <link rel="icon" type="image/jpeg" href="/escudo.jpg" />
    <link rel="apple-touch-icon" href="/escudo.jpg" />
  </head>
  <body>
    <slot />
  </body>
</html>
