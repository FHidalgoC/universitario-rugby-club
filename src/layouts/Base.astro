---
import { club } from '../data/club';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Universitario Cantabria Rugby | Club de rugby en Santander (Cantabria)',
  description = `Club de rugby en Cantabria y Santander. Equipo Senior y escuela de rugby M8–M18 en ${club.campo} (${club.zona}). Entrenamientos ${club.training.days.toLowerCase()} de ${club.training.hours}.`,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsTeam',
  name: club.name,
  alternateName: club.short,
  sport: 'Rugby',
  url: club.url,
  logo: `${club.url}/escudo.jpg`,
  email: club.email,
  foundingDate: String(club.foundingYear),
  sameAs: [club.instagram],
  location: {
    '@type': 'Place',
    name: club.campo,
    address: {
      '@type': 'PostalAddress',
      streetAddress: club.address.street,
      addressLocality: club.address.locality,
      addressRegion: club.address.region,
      postalCode: club.address.postalCode,
      addressCountry: club.address.country,
    },
  },
  memberOf: {
    '@type': 'SportsOrganization',
    name: club.federation.name,
    url: club.federation.url,
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={club.name} />
    <meta property="og:image" content="https://universitariocantabriarugby.com/escudo.jpg" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/jpeg" href="/escudo.jpg" />
    <link rel="apple-touch-icon" href="/escudo.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
