---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { club } from '../data/club';
import { getMatches, getNextMatch, getLastResult } from '../lib/calendar';

const matches = await getMatches();
const nextMatch = getNextMatch(matches);
const lastResult = getLastResult(matches);
const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('es-ES', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' }).format(
    new Date(`${iso}T12:00:00Z`),
  );

const encodedQuery = encodeURIComponent(club.mapsQuery);
const mapEmbedUrl = `https://www.google.com/maps?q=${encodedQuery}&output=embed`;
const mapDirectionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodedQuery}`;
---

<Base>
  <SiteHeader />

  <main>
    <section id="inicio" class="hero">
      <div class="container">
        <img
          class="hero-logo"
          src="/escudo.jpg"
          alt={`Escudo del ${club.shield}`}
          width="140"
          height="140"
        />
        <span class="hero-shield">{club.shield}</span>
        <h1>
          {club.name}
          <span class="hero-subtitle">Club de rugby en Santander, Cantabria</span>
        </h1>
        <p class="hero-motto">{club.motto}</p>

        <a class="training-card" href="#entrenamientos">
          <span class="training-card-label">Entrenamos</span>
          <span class="training-card-when">
            <strong>{club.training.days}</strong>
            <span>{club.training.hours}</span>
          </span>
          <span class="training-card-where">{club.campo} · {club.zona}</span>
        </a>

        <div class="hero-actions">
          <a class="btn btn-primary" href={mapDirectionsUrl} target="_blank" rel="noopener noreferrer">
            Cómo llegar
          </a>
          <a class="btn btn-outline-light" href="#contacto">Contacto</a>
        </div>
      </div>
    </section>

    <section id="entrenamientos" class="section">
      <div class="container">
        <h2 class="section-title">Dónde y cuándo entrenamos</h2>
        <div class="schedule-grid">
          <div class="schedule-item">
            <span class="schedule-label">Días</span>
            <strong>{club.training.days}</strong>
          </div>
          <div class="schedule-item">
            <span class="schedule-label">Horario</span>
            <strong>{club.training.hours}</strong>
          </div>
          <div class="schedule-item">
            <span class="schedule-label">Lugar</span>
            <strong>{club.campo}</strong>
            <span>{club.zona}</span>
          </div>
        </div>
        <div class="map-wrapper">
          <iframe
            src={mapEmbedUrl}
            title={`Mapa de ${club.campo} en ${club.zona}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
        <a class="btn btn-navy" href={mapDirectionsUrl} target="_blank" rel="noopener noreferrer">
          Cómo llegar
        </a>
      </div>
    </section>

    <section id="partidos" class="section section-alt">
      <div class="container">
        <h2 class="section-title">Partidos</h2>
        {
          nextMatch || lastResult ? (
            <div class="schedule-grid">
              {nextMatch && (
                <div class="schedule-item">
                  <span class="schedule-label">Próximo partido · Jornada {nextMatch.jornada}</span>
                  <strong>{nextMatch.home} vs {nextMatch.away}</strong>
                  <span>
                    <time datetime={nextMatch.date}>{formatDate(nextMatch.date)}</time>
                    {nextMatch.time !== '00:00' && ` · ${nextMatch.time}`}
                  </span>
                  {nextMatch.venue && <span>{nextMatch.venue}</span>}
                </div>
              )}
              {lastResult && (
                <div class="schedule-item">
                  <span class="schedule-label">Último resultado · Jornada {lastResult.jornada}</span>
                  <strong>
                    {lastResult.home} {lastResult.homeScore} – {lastResult.awayScore} {lastResult.away}
                  </strong>
                  <span>
                    <time datetime={lastResult.date}>{formatDate(lastResult.date)}</time>
                  </span>
                </div>
              )}
            </div>
          ) : (
            <p class="lead">Consulta las fechas de la temporada en el calendario de la Liga Norte.</p>
          )
        }
        <a class="btn btn-navy" href="/calendario/">Ver calendario completo</a>
      </div>
    </section>

    <section id="quienes-somos" class="section">
      <div class="container">
        <h2 class="section-title">Quiénes somos</h2>
        <p class="lead">{club.about}</p>
      </div>
    </section>

    <section id="categorias" class="section section-alt">
      <div class="container">
        <h2 class="section-title">Categorías</h2>
        <p class="lead">{club.categoriesIntro}</p>
        <ul class="categories-list">
          {
            club.categories.map((cat) => (
              <li>
                <strong>{cat.name}</strong>
                <span>{cat.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="contacto" class="section">
      <div class="container">
        <h2 class="section-title">Contacto</h2>
        <p class="lead">
          ¿Quieres venir a probar o tienes alguna duda? Escríbenos directamente por Instagram o
          envíanos un correo electrónico.
        </p>
        <div class="contact-actions">
          <a class="btn btn-primary" href={club.instagramDm} target="_blank" rel="noopener noreferrer">
            Mensaje directo en Instagram
          </a>
          <a class="btn btn-navy" href={`mailto:${club.email}`}>
            {club.email}
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
